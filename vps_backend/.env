PORT=3000

# Tripay Payment Gateway
TRIPAY_API_KEY=ganti_dengan_api_key_anda
TRIPAY_PRIVATE_KEY=ganti_dengan_private_key_anda
TRIPAY_MERCHANT_CODE=kode_merchant_anda
TRIPAY_MODE=sandbox # ubah ke production jika sudah live

# WhatsApp Gateway (Fonnte)
FONNTE_TOKEN=ganti_dengan_token_fonnte

# MikroTik Router
MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASS=password_mikrotik
MIKROTIK_HOTSPOT_PROFILE=default
